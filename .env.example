# Windows Authentication: same Windows user that can sign into SQL Server.
SQLSERVER_SERVER=.\SQLEXPRESS
SQLSERVER_DATABASE=GiaoGonShipper
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
PORT=5006
# For SQL Authentication, configure the full connection string locally.
# SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=GiaoGonShipper;UID=your_user;PWD=your_password;Encrypt=yes;TrustServerCertificate=yes;
# SECRET_KEY=replace-with-a-long-random-secret
# COOKIE_SECURE=1  # enable only when serving through HTTPS
